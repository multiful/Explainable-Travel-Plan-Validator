# ──────────────────────────────────────────────────────────────
# Explainable Travel Plan Validator — 환경변수 템플릿
# 사용법: cp .env.example .env  후 실제 키 입력 (.env 는 git 제외)
# ──────────────────────────────────────────────────────────────

# --- Claude (Evidence 설명 + Repair 제안) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# --- 한국관광공사 TourAPI ---
TOUR_API_KEY=
WELLNESS_API_KEY=        # 미설정 시 TOUR_API_KEY 로 자동 대체
BARRIER_FREE_API_KEY=    # 미설정 시 TOUR_API_KEY 로 자동 대체

# --- 카카오 (좌표 검색 + 이동시간 행렬) ---
KAKAO_REST_API_KEY=
KAKAO_MOBILITY_KEY=

# --- 서울 열린데이터광장 (실시간 도시데이터) ---
SEOUL_DATA_API_KEY=

# --- 네이버 (장소 메타데이터 보강) ---
NAVER_API_KEY=

# --- Neo4j (지식그래프 / 선택) ---
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# --- 캐시 (선택) ---
REDIS_URL=
